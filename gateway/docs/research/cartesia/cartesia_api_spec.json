        {
          "name": "Kyle",
          "id": "c961b81c-a935-4c17-bfb3-ba2239de8c2f",
          "category": "Expressive Characters",
          "characteristics": "Emotive, expressive"
        }
      ],
      "supported_languages": [
        "en", "fr", "de", "es", "pt", "zh", "ja", "hi", "it", "ko",
        "nl", "pl", "ru", "sv", "tr", "tl", "bg", "ro", "ar", "cs",
        "el", "fi", "hr", "ms", "sk", "da", "ta", "uk", "hu", "no",
        "vi", "bn", "th", "he", "ka", "id", "te", "gu", "kn", "ml",
        "mr", "pa"
      ],
      "ssml_support": {
        "emotion": "<emotion value='excited'>Text here</emotion>",
        "speed": "<speed ratio='1.05'>Text here</speed>",
        "volume": "<volume>Text here</volume>",
        "laughter": "[laughter]"
      },
      "voice_cloning": {
        "minimum_audio_duration": "3 seconds",
        "quality": "Highly similar, lifelike",
        "preservation": ["speaking style", "accent", "background", "emotion", "vocal characteristics"],
        "api_method": "client.voices.clone()"
      },
      "audio_formats": {
        "websocket_streaming": ["pcm_s16le", "pcm_f32le"],
        "rest_endpoint": ["WAV", "MP3", "PCM"]
      },
      "performance": {
        "model_latency": "135ms",
        "first_chunk_latency": "~135ms",
        "pricing": "1 credit per 1 second"
      }
    }
  },
  "integration_notes": {
    "authentication": {
      "method": "API key",
      "delivery": ["query parameter (WebSocket compatible)", "HTTP header"],
      "token_generation": "client.auth.access_token()"
    },
    "version_management": {
      "tts_versions": ["2024-06-10", "2024-11-13", "2025-04-16"],
      "stt_versions": "implicit in model selection",
      "recommendation": "Use base model names for dev, date-versioned for production"
    },
    "python_sdk_methods": {
      "tts": ["client.tts.bytes()", "client.tts.sse()"],
      "stt": ["client.stt.transcribe()"],
      "voices": ["client.voices.list()", "client.voices.clone()"],
      "utilities": ["client.api_status.get()", "client.auth.access_token()"]
    },
    "zero_copy_optimization": [
      "Use shared memory rings for IPC (Rust gateway ↔ Python)",
      "Stream audio chunks directly without serialization",
      "Parse timestamps in-stream for non-blocking I/O",
      "Avoid materializing full responses"
    ]
  },
