{
  "name": "@waav/cli",
  "version": "1.0.0",
  "description": "Beautiful interactive CLI for WaaV Voice AI Gateway",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "waav": "./dist/index.js"
  },
  "keywords": [
    "voice",
    "ai",
    "stt",
    "tts",
    "cli",
    "gateway",
    "realtime",
    "speech-to-text",
    "text-to-speech",
    "deepgram",
    "elevenlabs",
    "openai"
  ],
  "author": "WaaV Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build",
    "pkg:linux": "pkg . --targets node20-linux-x64 --output dist/waav-linux",
    "pkg:macos": "pkg . --targets node20-macos-x64 --output dist/waav-macos",
    "pkg:win": "pkg . --targets node20-win-x64 --output dist/waav-win.exe",
    "pkg:all": "npm run pkg:linux && npm run pkg:macos && npm run pkg:win"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "ink-gradient": "^3.0.0",
    "ink-big-text": "^2.0.0",
    "react": "^18.3.1",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "gradient-string": "^2.0.2",
    "ora": "^8.0.1",
    "conf": "^13.0.1",
    "js-yaml": "^4.1.0",
    "ws": "^8.18.0",
    "xstate": "^5.18.2",
    "@xstate/react": "^4.1.3",
    "zod": "^3.23.8",
    "figlet": "^1.8.0",
    "boxen": "^8.0.1",
    "nanoid": "^5.0.8",
    "cli-table3": "^0.6.5",
    "wrap-ansi": "^9.0.0",
    "strip-ansi": "^7.1.0",
    "ansi-escapes": "^7.0.0",
    "terminal-size": "^4.0.0",
    "node-record-lpcm16": "^1.0.1",
    "speaker": "^0.5.5",
    "play-sound": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "prettier": "^3.3.3",
    "pkg": "^5.8.1",
    "ink-testing-library": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waav/gateway.git",
    "directory": "gateway/cli"
  },
  "bugs": {
    "url": "https://github.com/waav/gateway/issues"
  },
  "homepage": "https://waav.ai",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "assets/**/*"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-win-x64"
    ]
  }
}
