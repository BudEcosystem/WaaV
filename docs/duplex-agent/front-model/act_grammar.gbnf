# Example instance of the per-decision grammar of W2 section 3.2.5: the caller said
# 'can you check if my bag is included in the fare' while t1 (your flight search) is working.
# The gateway builds one such grammar per decision; regenerate with front_reference.py --write-grammars.
# act_grammar.gbnf: WaaV front act grammar (front-act-2), generated by front_reference.py
# persona northwind-travel-ava@1; decision W2-3.2.5-example; trigger user_turn_ended; say mode compose
# allowed: wait, control, delegate, update, abort, progress, social, refuse
# polar question: True; copy spans: on; max span words 7
# The assistant turn is prefilled with {"act":" so this grammar describes only the continuation;
# the first generated character names the act (no two acts share their first letter).
# Rule names use only letters, digits and '-' (llama.cpp build 11200 rejects '_' in names),
# and every alternation of a rule stays on one line (a continuation line may not start with '|').

root ::= wait-act | control-act | delegate-act | update-act | abort-act | progress-act | social-act | refuse-act
wait-act ::= "wait\",\"why\":\"" why "\",\"say\":\"\"}"
control-act ::= "control\",\"kind\":\"" ckind ",\"say\":\"\"}"
delegate-act ::= "delegate\",\"say\":\"" ack "\"}"
update-act ::= "update\",\"task\":\"" utask "\",\"say\":\"" restate "\"}"
abort-act ::= "abort\",\"task\":\"" utask "\",\"say\":\"\"}"
progress-act ::= "progress\",\"task\":\"" ( ( "t1\"" notified? ",\"say\":\"" prog-t1 ) ) "\"}"
social-act ::= "social\",\"say\":\"" social "\"}"
refuse-act ::= "refuse\",\"say\":\"" refuse "\"}"
why ::= "incomplete" | "continuer" | "side_talk" | "nothing"
cv-repeat ::= "last" | "answer" | "number" | "time" | "name" | "address" | "code" | "slower" | "louder"
cv-spell ::= "number" | "time" | "name" | "address" | "code"
cv-rate ::= "slower" | "faster" | "normal"
cv-volume ::= "louder" | "quieter" | "normal"
cv-verbosity ::= "brief" | "normal" | "detailed"
cv-voice ::= "male" | "female" | "young" | "old" | "american" | "british" | "australian" | "irish" | "indian"
cv-backchannels ::= "on" | "off"
cv-updates ::= "ask" | "tell" | "screen"
cv-to-screen ::= "number" | "time" | "name" | "address" | "code"
ckind ::= "stop\"" | "hold\"" | "resume\"" | "repeat\"" ( ",\"value\":\"" cv-repeat "\"" )? | "not_heard\"" | "clarify\"" | "spell\"" ( ",\"value\":\"" cv-spell "\"" )? | "rate\"" ",\"value\":\"" cv-rate "\"" | "volume\"" ",\"value\":\"" cv-volume "\"" | "verbosity\"" ",\"value\":\"" cv-verbosity "\"" | "language\"" ",\"value\":\"" clang "\"" | "voice\"" ( ",\"value\":\"" cv-voice ( " " cv-voice )? "\"" )? | "backchannels\"" ",\"value\":\"" cv-backchannels "\"" | "updates\"" ",\"value\":\"" cv-updates "\"" | "to_screen\"" ( ",\"value\":\"" cv-to-screen "\"" )? | "end\"" | "human\""
clang ::= "en" | "es" | "fr" | "de" | "it" | "pt" | "nl" | "zh" | "ja" | "ko" | "hi" | "ar" | "ru" | "tr" | "pl" | "sv"
utask ::= "t1"
opener ::= "Okay" | "Got it" | "Alright" | "One moment" | "Good question"
inquiry ::= "let me check" | "let me check whether" | "I'll find out if" | "I'll look into" | "let me look into"
a10-1 ::= "fare"
a9-2 ::= "the" ( " " a10-1 )?
a8-3 ::= "in" ( " " a9-2 )?
a7-4 ::= "included" ( " " a8-3 )?
a6-5 ::= "is" ( " " a7-4 )?
a5-6 ::= "bag" ( " " a6-5 )?
a4-7 ::= "your" ( " " a5-6 )?
a10-2 ::= "fare"
a9-3 ::= "the" ( " " a10-2 )?
a8-4 ::= "in" ( " " a9-3 )?
a7-5 ::= "included" ( " " a8-4 )?
a6-6 ::= "is" ( " " a7-5 )?
a5-7 ::= "bag" ( " " a6-6 )?
a10-4 ::= "fare"
a9-5 ::= "the" ( " " a10-4 )?
a8-6 ::= "in" ( " " a9-5 )?
a7-7 ::= "included" ( " " a8-6 )?
a10-5 ::= "fare"
a9-6 ::= "the" ( " " a10-5 )?
a8-7 ::= "in" ( " " a9-6 )?
a10-6 ::= "fare"
a9-7 ::= "the" ( " " a10-6 )?
a10-7 ::= "fare"
aspan ::= a4-7 | a5-7 | a7-7 | a8-7 | a9-7 | a10-7
ack ::= opener ( ", " inquiry ( " " aspan )? )? "."
uopener ::= "Okay" | "Got it" | "Alright"
r5-6 ::= "bag"
r4-7 ::= "your" ( " " r5-6 )?
r5-7 ::= "bag"
r10-5 ::= "fare"
r9-6 ::= "the" ( " " r10-5 )?
r8-7 ::= "in" ( " " r9-6 )?
r10-6 ::= "fare"
r9-7 ::= "the" ( " " r10-6 )?
r10-7 ::= "fare"
rspan ::= r4-7 | r5-7 | r8-7 | r9-7 | r10-7
closer ::= " instead" | " then"
restate ::= uopener ", " rspan closer? "."
social ::= "Hi there, how can I help with your travel?" | "You're very welcome." | "Thanks for calling Northwind Travel. Safe travels." | "Yes, I'm here." | "You've reached Northwind Travel. I'm Ava, an automated assistant." | "I'm doing well, thanks for asking." | "That sounds lovely." | "Fair enough." | "I hear you." | "Glad to hear it."
refuse ::= "That's not something I can help with on this call." | "Sorry, I can't help with that here." | "I'm not able to help with that on this line." | "That's outside what I can do on this call."
notified ::= ",\"notify\":\"" ( "tell" | "screen" ) "\""
wopener ::= "Still working on it" | "I'm still on it" | "Still checking on that" | "It's still in progress"
prog-t1 ::= wopener "." | "Still working on your flight search."
