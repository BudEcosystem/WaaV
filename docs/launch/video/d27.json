   "messages": [
    {
     "t": 1.06,
     "who": "caller",
     "kind": "you",
     "text": "Morning, Ava! Can you pull up the GitHub release for WaaV one point one and check it all looks right?"
    },
    {
     "t": 7.7923,
     "who": "agent",
     "kind": "acknowledges",
     "text": "Let me look into that."
    },
    {
     "t": 12.7828,
     "who": "agent",
     "kind": "answer",
     "text": "Morning!"
    },
    {
     "t": 13.9819,
     "who": "agent",
     "kind": "answer",
     "text": "I'm pulling up the version one point one release on GitHub now to check it over."
    },
    {
     "t": 18.3131,
     "who": "agent",
     "kind": "answer",
     "text": "I'll tell you what I find."
    },
    {
     "t": 20.5027,
     "who": "agent",
     "kind": "progress",
     "text": "Opening the release page."
    },
    {
     "t": 27.1413,
     "who": "agent",
     "kind": "update",
     "text": "The GitHub release page shows the latest version as 1.1.0 with notes on interaction mode and all three files. The details are on your screen."
    },
    {
     "t": 37.026,
     "who": "caller",
     "kind": "you",
     "text": "Thanks. Remind me, how many speech vendors do we support now?"
    },
    {
     "t": 41.8725,
     "who": "agent",
     "kind": "acknowledges",
     "text": "Just a second."
    },
    {
     "t": 43.5832,
     "who": "agent",
     "kind": "answer",
     "text": "Forty-four speech vendors."
    },
    {
     "t": 45.3016,
     "who": "agent",
     "kind": "answer",
     "text": "That's thirty-one for speech-to-text, thirty-four for text-to-speech and eleven for speech-to-speech, and it works with any LLM."
    },
    {
     "t": 54.084,
     "who": "caller",
     "kind": "you",
     "text": "Great. Can you also get the download numbers in the terminal?"
    },
    {
     "t": 58.391,
     "who": "agent",
     "kind": "acknowledges",
     "text": "Let me look into that."
    },
    {
     "t": 62.2495,
     "who": "agent",
     "kind": "answer",
     "text": "I'm pulling the download numbers in the terminal now."
    },
    {
     "t": 65.2794,
     "who": "agent",
     "kind": "answer",
     "text": "I'll read them out as soon as they're in."
    },
    {
     "t": 67.749,
     "who": "agent",
     "kind": "progress",
     "text": "Fetching release download counts."
    },
    {
     "t": 78.247,
     "who": "agent",
